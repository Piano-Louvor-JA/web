VITE_APP_MODE=development
VITE_URL_FILES=https://files.louvorja.com.br
VITE_URL_DATABASE=https://api.pianolouvorja.com.br/json_db
# Origem pública upstream que publica /db/* (manifest + bundles) — SPEC piano-bundle-sync v1.2.0 ADR-11.
VITE_URL_BUNDLES=https://api.louvorja.com.br
VITE_API_TOKEN=
# Chaves próprias do web (não reutilizar as do desktop ou APK).
# Vite incorpora os valores no build; manter somente a chave do ambiente alvo.
VITE_PARTNER_KEY_STG=
VITE_PARTNER_KEY_PROD=
# Override opcional para API local ou build de ambiente único.
VITE_PARTNER_KEY=
# Origem pública da piano-api para receivers /palco. Ex.: https://api.example.com
VITE_PALCO_API_URL=

# Fallbacks em cascata (vírgula) — usados quando a API primária cair.
VITE_API_FALLBACK_URLS=https://api.louvorja.com.br,https://api.louvorja.workers.dev

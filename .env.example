VITE_APP_MODE=development
VITE_URL_FILES=https://files.louvorja.com.br
VITE_URL_DATABASE=https://api.pianolouvorja.com.br/json_db
# Origem pública upstream que publica /db/* (manifest + bundles) — SPEC piano-bundle-sync v1.2.0 ADR-11.
VITE_URL_BUNDLES=https://api.louvorja.com.br

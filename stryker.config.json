{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Initial shared-service/composable mutation baseline. Raise break after the first verified CI baseline.",
  "packageManager": "npm",
  "reporters": ["html", "clear-text", "progress"],
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.stryker.config.ts"
  },
  "coverageAnalysis": "off",
  "incremental": true,
  "incrementalFile": "stryker-incremental.json",
  "mutate": [
    "src/shared/services/**/*.ts",
    "src/shared/composables/**/*.ts"
  ],
  "thresholds": {
    "high": 100,
    "low": 31,
    "break": 30
  },
  "timeoutMS": 30000,
  "concurrency": 2,
  "ignorePatterns": [
    "**/node_modules/**",
    "e2e/**",
    "site/**"
  ]
}

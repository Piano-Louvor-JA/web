{
  "name": "louvorja-piano-web",
  "version": "1.25.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "version:major": "npm version major -m \"chore: versão %s\"",
    "version:minor": "npm version minor -m \"chore: versão %s\"",
    "version:patch": "npm version patch -m \"chore: versão %s\"",
    "version:max": "npm run version:major",
    "version:min": "npm run version:minor",
    "version:bug": "npm run version:patch",
    "dev": "vite",
    "preview": "vite preview",
    "host": "vite --host",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:mutation": "stryker run",
    "git:tag": "git tag -a \"v$npm_package_version\" -m \"Versão $npm_package_version\" && git push origin \"v$npm_package_version\"",
    "git:publish": "git push -u origin HEAD --follow-tags",
    "test:regression": "node scripts/test-regression.mjs",
    "test:coverage:gate": "vitest run --coverage",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@sentry/browser": "^11.7.0",
    "@tabler/icons-webfont": "^3.49.0",
    "@vue/server-renderer": "^3.5.44",
    "fflate": "^0.8.3",
    "firebase": "^13.0.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.14",
    "vue-router": "^5.4.0",
    "vuetify": "^4.2.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@storybook/vue3-vite": "10.6.2",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.4",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "~30.1.2",
    "npm-run-all2": "^9.0.3",
    "sass": "^1.105.1",
    "storybook": "10.6.2",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.0",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.4",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "description": "LouvorJA - PIANO — versão web para gerenciamento de culto",
  "author": "Ezequias Fonseca",
  "overrides": {
    "@grpc/grpc-js": "1.14.5",
    "@tabler/icons-webfont": {
      "svgtofont": "npm:noop2@2.0.0",
      "svg-path-commander": "npm:noop2@2.0.0",
      "@tabler/icons": "npm:noop2@2.0.0"
    }
  }
}
